# PostgreSQL connection used by the MCP server, CLI, and optional API.
PEOPLE_MEMORY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Protects the REST API with Authorization: Bearer <token>.
PEOPLE_MEMORY_API_TOKEN=

# Optional. Enables the guarded read_query/write_query MCP tools.
PEOPLE_MEMORY_ENABLE_RAW_SQL=false

# Optional. The source attached to facts written by the agent.
PEOPLE_MEMORY_DEFAULT_SOURCE=agent

# Optional. Comma-separated browser origins for the REST API.
PEOPLE_MEMORY_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
